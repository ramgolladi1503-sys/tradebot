{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CandidateRecord",
  "type": "object",
  "properties": {
    "strategy_id": { "type": "string" },
    "strategy_version": { "type": "string" },
    "contract_hash": { "type": "string" },
    "dataset_group_hash": { "type": "string" },
    "source_manifest_hash": { "type": "string" },
    "session_date": { "type": "string" },
    "primary_instrument": { "type": "string" },
    "confirmation_instrument": { "type": "string" },
    "direction": { "type": "string", "enum": ["LONG", "SHORT", "NONE"] },
    "candidate_accepted": { "type": "boolean" },
    "primary_rejection_reason": { "type": "string" },
    "all_rejections": {
      "type": "array",
      "items": { "type": "string" }
    },
    "session_quality_status": { "type": "string", "enum": ["PASSED", "FAILED"] },
    "nifty_opening_return": { "type": "number" },
    "bnifty_opening_return": { "type": "number" },
    "shock_threshold": { "type": "number" },
    "shock_percentile": { "type": "integer" },
    "close_location": { "type": "number" },
    "retained_move_fraction": { "type": "number" },
    "opening_high": { "type": "number" },
    "opening_low": { "type": "number" },
    "opening_midpoint": { "type": "number" },
    "session_open": { "type": "number" },
    "opening_close": { "type": "number" },
    "decision_close": { "type": "number" },
    "session_anchor": { "type": "number" },
    "anchor_type": { "type": "string" },
    "feature_cutoff_timestamp": { "type": "string" },
    "signal_timestamp": { "type": "string" },
    "earliest_legal_entry_timestamp": { "type": "string" },
    "source_file_identities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "candidate_fingerprint": { "type": "string" }
  },
  "required": [
    "strategy_id",
    "strategy_version",
    "contract_hash",
    "dataset_group_hash",
    "source_manifest_hash",
    "session_date",
    "primary_instrument",
    "confirmation_instrument",
    "direction",
    "candidate_accepted",
    "primary_rejection_reason",
    "all_rejections",
    "session_quality_status",
    "nifty_opening_return",
    "bnifty_opening_return",
    "shock_threshold",
    "shock_percentile",
    "close_location",
    "retained_move_fraction",
    "opening_high",
    "opening_low",
    "opening_midpoint",
    "session_open",
    "opening_close",
    "decision_close",
    "session_anchor",
    "anchor_type",
    "feature_cutoff_timestamp",
    "signal_timestamp",
    "earliest_legal_entry_timestamp",
    "candidate_fingerprint"
  ]
}
