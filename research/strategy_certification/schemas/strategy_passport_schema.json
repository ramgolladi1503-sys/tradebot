{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tradebot-strategy-passport-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "strategy_id",
    "hypothesis_id",
    "family",
    "instrument",
    "direction",
    "status",
    "certification",
    "screen_metrics",
    "robustness",
    "integration",
    "hard_rules"
  ],
  "properties": {
    "schema_version": {"const": "tradebot-strategy-passport-v1"},
    "strategy_id": {"type": "string", "pattern": "^STRAT-[A-Z0-9]{12}$"},
    "hypothesis_id": {"type": "string", "pattern": "^HYP-[A-Z0-9]{12}$"},
    "family": {"type": "string", "minLength": 1},
    "instrument": {"type": "string", "minLength": 1},
    "direction": {"enum": ["BUY_CE", "BUY_PE"]},
    "status": {"enum": ["REJECTED", "PROMISING_NOT_CERTIFIED"]},
    "certification": {"const": "NOT_CERTIFIED"},
    "screen_metrics": {"type": "object"},
    "robustness": {
      "type": "object",
      "required": ["walk_forward", "negative_controls", "holdout", "parameter_stability", "cost_stress"],
      "properties": {
        "walk_forward": {"const": "PENDING"},
        "negative_controls": {"const": "PENDING"},
        "holdout": {"const": "PENDING"},
        "parameter_stability": {"const": "PENDING"},
        "cost_stress": {"const": "PENDING"}
      }
    },
    "integration": {
      "type": "object",
      "required": ["tradebot_adapter_status", "allowed_tradebot_mode", "runtime_authority", "broker_actions_allowed"],
      "properties": {
        "tradebot_adapter_status": {"const": "BLOCKED_UNTIL_CERTIFIED"},
        "allowed_tradebot_mode": {"const": "RESEARCH_ONLY"},
        "runtime_authority": {"const": "NONE"},
        "broker_actions_allowed": {"const": false}
      }
    },
    "hard_rules": {
      "type": "object",
      "required": ["fallback_execution_data_used", "live_trading_allowed", "manual_approval_required_for_any_future_runtime_use"],
      "properties": {
        "fallback_execution_data_used": {"const": false},
        "live_trading_allowed": {"const": false},
        "manual_approval_required_for_any_future_runtime_use": {"const": true}
      }
    }
  }
}
