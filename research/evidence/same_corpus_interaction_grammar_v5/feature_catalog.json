      ],
      "causal_availability_time": "COMPLETED_BAR",
      "uses_completed_bars_only": true,
      "uses_future_data": false,
      "missing_data_behavior": "BLOCK",
      "validation_examples": [
        "count of touches within 10bps of session extreme"
      ]
    },
    {
      "feature_name": "gap_from_prior_close",
      "inputs": [
        "session_open",
        "prior_session_close"
