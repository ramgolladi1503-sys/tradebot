{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tradebot.option-analytics-v1.evidence.schema.json",
  "title": "TradeBot Option Analytics V1 Evidence",
  "type": "object",
  "required": ["schema_version"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "input_case_count": {"type": "integer", "minimum": 0},
    "output_case_count": {"type": "integer", "minimum": 0},
    "failure_count": {"type": "integer", "minimum": 0},
    "semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
