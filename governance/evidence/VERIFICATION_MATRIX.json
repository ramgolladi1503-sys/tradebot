  "gates": {
    "G1_SOURCE": {
      "evidence_type": "SOURCE_VERIFICATION_EVIDENCE",
      "allowed_roles": [
        "PRODUCT_OWNER",
        "BUSINESS_ANALYST",
        "SOLUTION_ARCHITECT",
        "SYSTEM_ARCHITECT",
        "QUANT_RESEARCH_ARCHITECT"
      ]
    },
    "G2_CORRECTNESS": {
      "evidence_type": "CORRECTNESS_VERIFICATION_EVIDENCE",
      "allowed_roles": [
        "QA_ENGINEER",
        "SENIOR_QA"
      ]
    },
    "G3_ADVERSARIAL": {
      "evidence_type": "ADVERSARIAL_VERIFICATION_EVIDENCE",
      "allowed_roles": [
        "QA_ENGINEER",
        "SENIOR_QA"
      ]
    },
    "G4_INDEPENDENT": {
      "evidence_type": "INDEPENDENT_EVIDENCE",
      "allowed_roles": [
        "QUANT_RESEARCH_ARCHITECT",
        "UAT_REVIEWER",
        "RELEASE_MANAGER",
        "PRODUCTION_SRE"
      ]
    }
  },
  "claim_kinds_requiring_research_certification": [
    "predictive_validity",
    "profitability"
  ],
  "limitations": [
    "A passing evidence check is not merge approval, research certification, or runtime readiness; branch protection must separately require its status to block merges.",
