{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradebot.local/schemas/agentic-qa-advisory-review-v1.json",
  "title": "TradeBot Agentic QA Advisory Review",
  "type": "object",
  "required": ["summary", "risk_categories", "recommended_next_tests", "evidence_citations", "uncertainties", "deterministic_verdict"],
  "properties": {
    "summary": {"type": "string"},
    "risk_categories": {"type": "array", "items": {"type": "string"}},
    "recommended_next_tests": {"type": "array", "items": {"type": "string"}},
    "evidence_citations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "uncertainties": {"type": "array", "items": {"type": "string"}},
    "deterministic_verdict": {"type": "string"}
  },
  "additionalProperties": false
}
