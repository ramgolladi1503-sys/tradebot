{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradebot.local/schemas/agentic-qa-run-manifest-v1.json",
  "title": "TradeBot Agentic QA Run Manifest",
  "type": "object",
  "required": ["run_id", "trace_id", "repository_commit", "policy_version", "artifacts"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "minLength": 1},
    "repository_commit": {"type": "string", "minLength": 7},
    "policy_version": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
            },
            "additionalProperties": true
          }
        ]
      }
    }
  },
  "additionalProperties": true
}
