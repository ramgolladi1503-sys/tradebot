{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TradeTruthProspectiveCaptureSchema",
  "description": "Authoritative prospective full Level-C causal capture schema across entire decision lifecycle.",
  "type": "object",
  "required": [
    "trace_id",
    "session_id",
    "session_date",
    "decision_ts_epoch",
    "decision_ts_str",
    "code_lineage",
    "raw_market_capture",
    "bar_capture",
    "memory_capture",
    "feature_capture",
    "regime_capture",
    "strategy_evaluations",
    "candidate_pool",
    "option_selection",
    "ranking",
    "trade_construction",
    "risk_state_evaluation",
    "governance_validation",
    "final_decision",
    "future_leak_audit",
    "truth_record"
  ],
  "properties": {
    "trace_id": {
      "type": "string"
    },
    "parent_trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "session_id": {
      "type": "string"
    },
    "session_date": {
      "type": "string"
    },
    "decision_ts_epoch": {
      "type": "number"
    },
    "decision_ts_str": {
      "type": "string"
    },
    "code_lineage": {
      "type": "object",
      "required": [
        "git_sha",
        "branch",
        "config_hash",
        "model_hashes",
        "strategy_catalog_hash",
        "instrument_master_hash",
        "schema_version",
        "truth_layer_version"
      ],
      "properties": {
        "git_sha": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "config_hash": {
          "type": "string"
        },
        "model_hashes": {
          "type": "object"
        },
        "strategy_catalog_hash": {
          "type": "string"
        },
        "instrument_master_hash": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "truth_layer_version": {
          "type": "string"
        }
      }
    },
    "raw_market_capture": {
      "type": "object",
      "required": [
        "source_file",
        "source_sha256",
        "event_count_used",
        "first_event_ts",
        "last_event_ts",
        "events_hash"
      ],
      "properties": {
        "source_file": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string"
        },
        "event_count_used": {
          "type": "integer"
        },
        "first_event_ts": {
          "type": "number"
        },
        "last_event_ts": {
          "type": "number"
        },
        "events_hash": {
          "type": "string"
        }
      }
    },
    "bar_capture": {
      "type": "object",
      "required": [
        "symbol",
        "timeframe",
        "bars_count",
        "first_bar_start_ts",
        "last_bar_end_ts",
        "bars_hash"
      ],
      "properties": {
        "symbol": {
          "type": "string"
        },
        "timeframe": {
          "type": "string"
        },
        "bars_count": {
          "type": "integer"
        },
        "first_bar_start_ts": {
          "type": "string"
        },
        "last_bar_end_ts": {
          "type": "string"
        },
        "bars_hash": {
          "type": "string"
        }
      }
    },
    "memory_capture": {
      "type": "object",
      "required": [
        "as_of_timestamp",
        "current_price",
        "session_open",
        "session_high",
        "session_low",
        "rolling_1m_bars_count",
        "rolling_15m_return_bps",
        "distance_from_session_open_bps",
        "rolling_15m_range_bps",
        "realized_vol_15m",
        "memory_hash"
      ],
      "properties": {
        "as_of_timestamp": {
          "type": "string"
        },
        "current_price": {
          "type": "number"
        },
        "session_open": {
          "type": "number"
        },
        "session_high": {
          "type": "number"
        },
        "session_low": {
          "type": "number"
        },
        "rolling_1m_bars_count": {
          "type": "integer"
        },
        "rolling_15m_return_bps": {
          "type": "number"
        },
        "distance_from_session_open_bps": {
          "type": "number"
        },
        "rolling_15m_range_bps": {
          "type": "number"
        },
        "realized_vol_15m": {
          "type": "number"
        },
        "memory_hash": {
          "type": "string"
        }
      }
    },
    "feature_capture": {
      "type": "object",
      "required": [
        "features",
        "features_hash"
      ],
      "properties": {
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "feature_name",
              "feature_value",
              "feature_timestamp",
              "feature_module",
              "feature_version"
            ],
            "properties": {
              "feature_name": {
                "type": "string"
              },
              "feature_value": {
                "type": [
                  "number",
                  "string",
                  "boolean",
                  "null"
                ]
              },
              "feature_timestamp": {
                "type": "string"
              },
              "feature_module": {
                "type": "string"
              },
              "feature_version": {
                "type": "string"
              }
            }
          }
        },
        "features_hash": {
          "type": "string"
        }
      }
    },
    "regime_capture": {
      "type": "object",
      "required": [
        "regime_status",
        "regime_state",
        "allowed_strategy_families",
        "regime_hash"
      ],
      "properties": {
        "regime_status": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "REGIME_STAGE_NOT_APPLICABLE",
            "DEGRADED",
            "UNKNOWN"
          ]
        },
        "regime_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "probabilities": {
          "type": [
            "object",
            "null"
          ]
        },
        "entropy": {
          "type": [
            "number",
            "null"
          ]
        },
        "allowed_strategy_families": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "regime_hash": {
          "type": "string"
        }
      }
    },
    "strategy_evaluations": {
      "type": "object",
      "required": [
        "evaluations",
        "strategy_eval_hash"
      ],
      "properties": {
        "evaluations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "strategy_id",
              "strategy_family",
              "qualified",
              "candidate_emitted",
              "reason_code",
              "strategy_hash"
            ],
            "properties": {
              "strategy_id": {
                "type": "string"
              },
              "strategy_family": {
                "type": "string"
              },
              "qualified": {
                "type": "boolean"
              },
              "candidate_emitted": {
                "type": "boolean"
              },
              "reason_code": {
                "type": "string"
              },
              "score": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "strategy_hash": {
                "type": "string"
              }
            }
          }
        },
        "strategy_eval_hash": {
          "type": "string"
        }
      }
    },
    "candidate_pool": {
      "type": "object",
      "required": [
        "candidates",
        "pool_hash"
      ],
      "properties": {
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "candidate_id",
              "strategy_id",
              "strategy_family",
              "symbol",
              "direction",
              "family_compatibility_pass",
              "pool_admission_pass",
              "block_reasons",
              "candidate_hash"
            ],
            "properties": {
              "candidate_id": {
                "type": "string"
              },
              "strategy_id": {
                "type": "string"
              },
              "strategy_family": {
                "type": "string"
              },
              "symbol": {
                "type": "string"
              },
              "direction": {
                "type": "string"
              },
              "family_compatibility_pass": {
                "type": "boolean"
              },
              "pool_admission_pass": {
                "type": "boolean"
              },
              "block_reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "candidate_hash": {
                "type": "string"
              }
            }
          }
        },
        "pool_hash": {
          "type": "string"
        }
      }
    },
    "option_selection": {
      "type": "object",
      "required": [
        "selection_status",
        "selected_instrument",
        "quote_executable_truth",
        "selection_hash"
      ],
      "properties": {
        "selection_status": {
          "type": "string",
          "enum": [
            "SELECTED",
            "REJECTED_NO_QUOTES",
            "REJECTED_SPREAD_EXCESSIVE",
            "SELECTION_STAGE_NOT_REACHED",
            "UNKNOWN"
          ]
        },
        "selected_instrument": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "tradingsymbol": {
              "type": "string"
            },
            "strike": {
              "type": "number"
            },
            "option_type": {
              "type": "string"
            },
            "expiry": {
              "type": "string"
            },
            "lot_size": {
              "type": "integer"
            }
          }
        },
        "quote_executable_truth": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "bid": {
              "type": "number"
            },
            "ask": {
              "type": "number"
            },
            "bid_qty": {
              "type": "integer"
            },
            "ask_qty": {
              "type": "integer"
            },
            "spread": {
              "type": "number"
            },
            "quote_ts_epoch": {
              "type": "number"
            },
            "reference_buy_price": {
              "type": "number"
            }
          }
        },
        "selection_hash": {
          "type": "string"
        }
      }
    },
    "ranking": {
      "type": "object",
      "required": [
        "ranking_status",
        "ranked_candidates",
        "top_candidate_id",
        "ranking_hash"
      ],
      "properties": {
        "ranking_status": {
          "type": "string",
          "enum": [
            "RANKED",
            "NO_ELIGIBLE_CANDIDATES",
            "RANKING_STAGE_NOT_REACHED"
          ]
        },
        "ranked_candidates": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "top_candidate_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "ranking_hash": {
          "type": "string"
        }
      }
    },
    "trade_construction": {
      "type": "object",
      "required": [
        "construction_status",
        "trade_object",
        "trade_hash"
      ],
      "properties": {
        "construction_status": {
          "type": "string",
          "enum": [
            "CONSTRUCTED",
            "TRADE_CONSTRUCTION_NOT_REACHED",
            "CONSTRUCTION_FAILED"
          ]
        },
        "trade_object": {
          "type": [
            "object",
            "null"
          ]
        },
        "trade_hash": {
          "type": "string"
        }
      }
    },
    "risk_state_evaluation": {
      "type": "object",
      "required": [
        "risk_input_snapshot",
        "risk_verdict",
        "risk_reasons",
        "risk_evaluation_hash"
      ],
      "properties": {
        "risk_input_snapshot": {
          "type": "object",
          "required": [
            "capital",
            "equity_high",
            "daily_pnl",
            "daily_pnl_pct",
            "open_risk",
            "open_risk_pct",
            "trades_today",
            "kill_switch_active"
          ],
          "properties": {
            "capital": {
              "type": "number"
            },
            "equity_high": {
              "type": "number"
            },
            "daily_pnl": {
              "type": "number"
            },
            "daily_pnl_pct": {
              "type": "number"
            },
            "open_risk": {
              "type": "number"
            },
            "open_risk_pct": {
              "type": "number"
            },
            "trades_today": {
              "type": "integer"
            },
            "kill_switch_active": {
              "type": "boolean"
            }
          }
        },
        "risk_verdict": {
          "type": "string",
          "enum": [
            "ALLOWED",
            "BLOCKED"
          ]
        },
        "risk_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risk_evaluation_hash": {
          "type": "string"
        }
      }
    },
    "governance_validation": {
      "type": "object",
      "required": [
        "governance_verdict",
        "governance_reasons",
        "governance_hash"
      ],
      "properties": {
        "governance_verdict": {
          "type": "string",
          "enum": [
            "GOVERNED_ALLOWED",
            "GOVERNED_BLOCKED"
          ]
        },
        "governance_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "governance_hash": {
          "type": "string"
        }
      }
    },
    "final_decision": {
      "type": "object",
      "required": [
        "action",
        "reason_codes",
        "decision_hash"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "ENTRY",
            "NO_TRADE",
            "BLOCKED",
            "SKIPPED",
            "ERROR"
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decision_hash": {
          "type": "string"
        }
      }
    },
    "future_leak_audit": {
      "type": "object",
      "required": [
        "decision_ts",
        "max_raw_event_ts",
        "max_bar_end_ts",
        "max_feature_input_ts",
        "max_regime_input_ts",
        "max_quote_ts",
        "future_leak_detected"
      ],
      "properties": {
        "decision_ts": {
          "type": "number"
        },
        "max_raw_event_ts": {
          "type": "number"
        },
        "max_bar_end_ts": {
          "type": "number"
        },
        "max_feature_input_ts": {
          "type": "number"
        },
        "max_regime_input_ts": {
          "type": "number"
        },
        "max_quote_ts": {
          "type": "number"
        },
        "future_leak_detected": {
          "type": "boolean"
        }
      }
    },
    "truth_record": {
      "type": "object",
      "required": [
        "record_hash",
        "chain_hash",
        "sequence_num",
        "read_only",
        "broker_api_called",
        "is_order_action"
      ],
      "properties": {
        "record_hash": {
          "type": "string"
        },
        "chain_hash": {
          "type": "string"
        },
        "sequence_num": {
          "type": "integer"
        },
        "read_only": {
          "type": "boolean"
        },
        "broker_api_called": {
          "type": "boolean"
        },
        "is_order_action": {
          "type": "boolean"
        }
      }
    }
  }
}